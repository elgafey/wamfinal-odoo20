#. module: bank_fees_allocation
#: model:ir.model.fields,help:bank_fees_allocation.field_res_config_settings__bank_fees_expense_account_id
msgid "Account where the bank fees are booked."
msgstr "الحساب الذي تُسجَّل فيه رسوم البنك."

#. module: bank_fees_allocation
#: model:ir.model.fields,help:bank_fees_allocation.field_res_company__bank_fees_expense_account_id
#: model_terms:ir.ui.view,arch_db:bank_fees_allocation.res_config_settings_view_form_bank_fees_allocation
msgid ""
"Account where the bank fees are booked. It must be configured, otherwise the"
" allocation cannot be confirmed."
msgstr "الحساب الذي تُسجَّل فيه رسوم البنك. يجب إعداده، وإلا فلا يمكن تأكيد التوزيع."

#. module: bank_fees_allocation
#: model:ir.model.fields,help:bank_fees_allocation.field_bank_fees_allocation_wizard__fee_account_id
msgid ""
"Account where the bank fees are booked. Only the expense accounts of the "
"company are proposed. Pre-filled from the company settings."
msgstr "الحساب الذي تُسجَّل فيه رسوم البنك. تُقترح حسابات المصروفات الخاصة بالشركة فقط. يُملأ مسبقًا من إعدادات الشركة."

#. module: bank_fees_allocation
#: model:ir.model.fields,help:bank_fees_allocation.field_res_company__bank_fees_allocation_account_ids
msgid ""
"Accounts the accountant works on: the Visa/card clearing accounts the "
"aggregated bank settlements are booked against. Only the journal items of "
"these accounts show up in the Bank Fees Allocation view. A branch may "
"configure several accounts."
msgstr "الحسابات التي يعمل عليها المحاسب: حسابات تسوية بطاقات فيزا التي تُسجَّل عليها تسويات البنك المجمّعة. تظهر بنود القيود الخاصة بهذه الحسابات فقط في عرض توزيع رسوم البنك. يمكن للفرع إعداد عدة حسابات."

#. module: bank_fees_allocation
#: model:ir.model.fields,help:bank_fees_allocation.field_res_config_settings__bank_fees_allocation_account_ids
msgid ""
"Accounts the accountant works on: the Visa/card clearing accounts. Only the "
"journal items of these accounts show up in the Bank Fees Allocation view."
msgstr "الحسابات التي يعمل عليها المحاسب: حسابات تسوية بطاقات فيزا. تظهر بنود القيود الخاصة بهذه الحسابات فقط في عرض توزيع رسوم البنك."

#. module: bank_fees_allocation
#: model_terms:ir.ui.view,arch_db:bank_fees_allocation.res_config_settings_view_form_bank_fees_allocation
msgid ""
"Accounts the accountant works on: the Visa/card clearing accounts. Only the "
"journal items of these accounts show up in the Bank Fees Allocation view. A "
"branch may configure several accounts."
msgstr "الحسابات التي يعمل عليها المحاسب: حسابات تسوية بطاقات فيزا. تظهر بنود القيود الخاصة بهذه الحسابات فقط في عرض توزيع رسوم البنك. يمكن للفرع إعداد عدة حسابات."

