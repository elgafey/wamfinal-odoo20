#. module: bank_fees_allocation
#: model_terms:ir.ui.view,arch_db:bank_fees_allocation.bank_fees_allocation_wizard_form
msgid ""
"One journal entry is created per branch, posted and reconciled with the\n"
"                        selected journal items: the bank receives the net amount, the fee is booked\n"
"                        on the fee account and every source account is credited."
msgstr "يُنشأ قيد يومية واحد لكل فرع، ثم يُرحَّل ويُسوَّى مع بنود القيود المحددة: يستلم البنك صافي المبلغ، وتُسجَّل الرسوم على حساب الرسوم، ويُقيَّد كل حساب مصدر."

#. module: bank_fees_allocation
#: model_terms:ir.ui.view,arch_db:bank_fees_allocation.report_bank_fees_allocation_summary
msgid "Per Bank Account"
msgstr "حسب الحساب البنكي"

#. module: bank_fees_allocation
#: model_terms:ir.ui.view,arch_db:bank_fees_allocation.report_bank_fees_allocation_summary
msgid "Per Branch"
msgstr "حسب الفرع"

#. module: bank_fees_allocation
#: model_terms:ir.ui.view,arch_db:bank_fees_allocation.report_bank_fees_allocation_summary
