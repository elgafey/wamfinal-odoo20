<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================== PDF summary of the allocations ================== -->
    <record id="action_bank_fees_allocation_summary" model="ir.actions.report">
        <field name="name">Allocation Summary</field>
        <field name="model">bank.fees.allocation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bank_fees_allocation.report_bank_fees_allocation_summary</field>
        <field name="print_report_name">'Bank Fees Allocation Summary'</field>
        <field name="binding_model_id" ref="model_bank_fees_allocation"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="group_ids" eval="[(4, ref('bank_fees_allocation.group_bank_fees_allocation_user'))]"/>
    </record>

    <template id="report_bank_fees_allocation_summary">
        <t t-call="web.report_layout">
            <t t-set="report" t-value="env['bank.fees.allocation.report']"/>
            <t t-set="totals" t-value="report._report_totals(docs)"/>
            <t t-set="period" t-value="report._report_period(docs)"/>
            <t t-set="currency" t-value="totals['currency']"/>
            <!-- The direction of the document follows the language of the
                 user: the tables then mirror correctly. -->
            <t t-set="direction"
               t-value="env['res.lang']._get_data(code=lang or env.user.lang).direction or 'ltr'"/>

            <div class="page" t-att-dir="direction">
                <style>
                    .bfa-summary { font-size: 9pt; }
                    .bfa-summary h2 { margin-bottom: 4mm; }
                    .bfa-summary h3 { margin: 5mm 0 2mm 0; font-size: 10pt; }
                    .bfa-summary table { width: 100%; }
                    .bfa-summary th { text-align: start; }
                    .bfa-summary td.num, .bfa-summary th.num { text-align: end; }
                </style>

                <h2>
                    Bank Fees Allocation Summary
                    <span t-if="period[0]" t-out="period[0]"/>
                    <span t-if="period[1]"> - <t t-out="period[1]"/></span>
                </h2>

                <!-- ================= totals ================= -->
                <table class="table table-sm bfa-summary">
                    <thead>
                        <tr>
                            <th>Total Sales</th>
                            <th>Total Fees</th>
                            <th>Total Net</th>
                            <th>Allocations</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span t-out="currency.format(totals['total_sales'])"/></td>
                            <td><span t-out="currency.format(totals['total_fees'])"/></td>
                            <td><span t-out="currency.format(totals['total_net'])"/></td>
                            <td><span t-out="totals['count']"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- ================= per bank account ================= -->
                <h3>Per Bank Account</h3>
                <table class="table table-sm bfa-summary">
                    <thead>
                        <tr>
                            <th>Bank Account</th>
                            <th>Total Sales</th>
                            <th>Total Fees</th>
                            <th>Total Net</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="report._report_by_bank_account(docs)" t-as="row">
                            <td><span t-out="row['bank_account'].display_name"/></td>
                            <td><span t-out="currency.format(row['total_sales'])"/></td>
                            <td><span t-out="currency.format(row['total_fees'])"/></td>
                            <td><span t-out="currency.format(row['total_net'])"/></td>
                            <td><span t-out="row['count']"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- ================= per period ================= -->
                <h3>Per Day</h3>
                <table class="table table-sm bfa-summary">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Total Sales</th>
                            <th>Total Fees</th>
                            <th>Total Net</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="report._report_by_day(docs)" t-as="row">
                            <td><span t-out="row['date']"/></td>
                            <td><span t-out="currency.format(row['total_sales'])"/></td>
                            <td><span t-out="currency.format(row['total_fees'])"/></td>
                            <td><span t-out="currency.format(row['total_net'])"/></td>
                            <td><span t-out="row['count']"/></td>
                        </tr>
                    </tbody>
                </table>

                <h3>Per Month</h3>
                <table class="table table-sm bfa-summary">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Total Sales</th>
                            <th>Total Fees</th>
                            <th>Total Net</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="report._report_by_month(docs)" t-as="row">
                            <td><span t-out="row['label']"/></td>
                            <td><span t-out="currency.format(row['total_sales'])"/></td>
                            <td><span t-out="currency.format(row['total_fees'])"/></td>
                            <td><span t-out="currency.format(row['total_net'])"/></td>
                            <td><span t-out="row['count']"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- ================= per source account ================= -->
                <h3>Per Source Account</h3>
                <table class="table table-sm bfa-summary">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Total Sales</th>
                            <th>Total Fees</th>
                            <th>Total Net</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="report._report_by_account(docs)" t-as="row">
                            <td><span t-out="row['account'].display_name"/></td>
                            <td><span t-out="currency.format(row['total_sales'])"/></td>
                            <td><span t-out="currency.format(row['total_fees'])"/></td>
                            <td><span t-out="currency.format(row['total_net'])"/></td>
                            <td><span t-out="row['count']"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- ================= detail ================= -->
                <h3>Allocations</h3>
                <table class="table table-sm bfa-summary">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Date</th>
                            <th>Bank Account</th>
                            <th>Total Sales</th>
                            <th>Fees</th>
                            <th>Net</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="doc">
                            <td><span t-out="doc.name"/></td>
                            <td><span t-out="doc.date"/></td>
                            <td><span t-out="doc.bank_account_id.display_name"/></td>
                            <td><span t-out="doc.currency_id.format(doc.total_amount)"/></td>
                            <td><span t-out="doc.currency_id.format(doc.fee_amount)"/></td>
                            <td><span t-out="doc.currency_id.format(doc.net_amount)"/></td>
                            <td><span t-out="doc.state"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

</odoo>
