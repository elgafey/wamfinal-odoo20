<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Two groups are created, following the Odoo 20 group format
        (`res.groups.privilege` + `privilege_id`):

        * Bank Fees Allocation / Administrator: everything, including the
          settings of the module.
        * Bank Fees Allocation / User: the accountant. They can open the
          allocation view and run the wizard, but the settings stay
          read-only for them.

        The groups are deliberately **not** part of the Accounting
        privilege: the module is a standalone application, so its users
        are not accountants by trade.

        The *User* group implies `account.group_account_invoice`, the
        **minimum** accounting group.  It is required by Odoo itself:
        `account.move._post()` refuses to post an entry when the user is
        not in that group ("You don't have the access rights to post an
        invoice.").  That group grants CRUD on the journal entries, the
        journal items and the partial reconciliations - exactly what the
        wizard needs - but **not** the accounting features (journal
        entries list, reports, reconciliation screens, configuration),
        which require `account.group_account_user`.

        The *Administrator* group implies `account.group_account_manager`
        so that the administrator can also configure the accounts of the
        company from the Accounting settings.
    -->
    <record model="res.groups.privilege" id="res_groups_privilege_bank_fees_allocation">
        <field name="name">Bank Fees Allocation</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_bank_fees_allocation_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_bank_fees_allocation"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user'), ref('account.group_account_invoice')])]"/>
        <field name="comment">Can open the Bank Fees Allocation view and run the allocation wizard.</field>
    </record>

    <record id="group_bank_fees_allocation_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_bank_fees_allocation"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_bank_fees_allocation_user'), ref('account.group_account_manager'), ref('base.group_system')])]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to the Bank Fees Allocation, including its settings.</field>
    </record>

</odoo>
