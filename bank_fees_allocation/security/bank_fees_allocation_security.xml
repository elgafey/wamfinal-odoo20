<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Two groups are created, following the Odoo 20 group format
        (`res.groups.privilege` + `privilege_id`):

        * Bank Fees Allocation / Administrator: everything, including the
          settings of the module.
        * Bank Fees Allocation / User: the accountant. They can open the
          allocation view and run the wizard, but the settings stay
          read-only for them.
    -->
    <record model="res.groups.privilege" id="res_groups_privilege_bank_fees_allocation">
        <field name="name">Bank Fees Allocation</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_bank_fees_allocation_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_bank_fees_allocation"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="comment">Can open the Bank Fees Allocation view and run the allocation wizard.</field>
    </record>

    <record id="group_bank_fees_allocation_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_bank_fees_allocation"/>
        <field name="implied_ids" eval="[(4, ref('group_bank_fees_allocation_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to the Bank Fees Allocation, including its settings.</field>
    </record>

</odoo>
