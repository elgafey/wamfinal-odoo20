<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The settings of the module, **inside the application**.

        The block used to live in the Accounting settings page.  Since the
        module is now a standalone application, the settings have their
        own page: the *Configuration > Settings* menu of the application
        opens it, and nothing of the global Accounting settings is
        touched anymore.

        The page is only reachable by the *Bank Fees Allocation /
        Administrator* group.
    -->
    <record id="res_config_settings_view_form_bank_fees_allocation" model="ir.ui.view">
        <field name="name">res.config.settings.form.bank.fees.allocation</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <form string="Bank Fees Allocation" class="oe_form_configuration" js_class="base_settings">
                <!-- The company of the settings. -->
                <field name="company_id" invisible="1"/>
                <!-- The records the user may pick: the drop-downs filter on
                     them with a plain list of tuples. -->
                <field name="allowed_allocation_account_ids" invisible="1"/>
                <field name="allowed_expense_account_ids" invisible="1"/>
                <field name="allowed_bank_account_ids" invisible="1"/>
                <field name="allowed_journal_ids" invisible="1"/>
                <app data-string="Bank Fees Allocation" string="Bank Fees Allocation"
                     name="bank_fees_allocation"
                     groups="bank_fees_allocation.group_bank_fees_allocation_administrator">
                    <block title="Bank Fees Allocation" name="bank_fees_allocation_setting_container">
                        <setting id="bank_fees_allocation_accounts_setting"
                                 string="Allocation Accounts"
                                 help="Accounts the accountant works on: the Visa/card clearing accounts. Only the journal items of these accounts show up in the Bank Fees Allocation view. A branch may configure several accounts.">
                            <field name="bank_fees_allocation_account_ids"
                                   widget="many2many_tags"
                                   placeholder="Pick the clearing accounts..."
                                   domain="[('id', 'in', allowed_allocation_account_ids)]"
                                   options="{'no_create': True}"/>
                        </setting>
                        <setting id="bank_fees_expense_account_setting"
                                 string="Bank Fees Expense Account"
                                 help="Account where the bank fees are booked. It must be configured, otherwise the allocation cannot be confirmed.">
                            <field name="bank_fees_expense_account_id"
                                   placeholder="Pick an expense account..."
                                   domain="[('id', 'in', allowed_expense_account_ids)]"
                                   options="{'no_create': True}"/>
                        </setting>
                        <setting id="bank_fees_bank_accounts_setting"
                                 string="Bank Accounts"
                                 help="Bank accounts offered in the allocation wizard. The amount credited by the bank is booked on the account picked there.">
                            <field name="bank_fees_bank_account_ids"
                                   widget="many2many_tags"
                                   placeholder="Pick the bank accounts..."
                                   domain="[('id', 'in', allowed_bank_account_ids)]"
                                   options="{'no_create': True}"/>
                        </setting>
                        <setting id="bank_fees_allocation_journal_setting"
                                 string="Allocation Journal"
                                 help="Journal used by the generated allocation entries. Defaults to the Miscellaneous journal of the company.">
                            <field name="bank_fees_allocation_journal_id"
                                   placeholder="Pick a miscellaneous journal..."
                                   domain="[('id', 'in', allowed_journal_ids)]"
                                   options="{'no_create': True}"/>
                        </setting>
                    </block>
                </app>
                <app data-string="Bank Fees Allocation" string="Bank Fees Allocation"
                     name="bank_fees_allocation"
                     groups="bank_fees_allocation.group_bank_fees_allocation_user"
                     invisible="1"/>
            </form>
        </field>
    </record>

    <!-- The action of the *Configuration > Settings* menu of the app. -->
    <record id="action_bank_fees_allocation_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_bank_fees_allocation"/>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'bank_fees_allocation'}</field>
    </record>

</odoo>
