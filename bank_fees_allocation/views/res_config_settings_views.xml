<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Settings > Invoicing: the company default for the Bank Fees Account.
         The wizard pre-fills from it; it stays editable per entry. -->
    <record id="res_config_settings_view_form_bank_fees" model="ir.ui.view">
        <field name="name">res.config.settings.form.bank.fees</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Closing Fees" name="bank_fees_setting_container">
                    <setting id="default_bank_fees_account_setting"
                             string="Default Bank Fees Account"
                             company_dependent="1"
                             help="Pre-fills the Bank Fees Account on the Closing Fees wizard, so nobody has to pick the same expense account every time. It stays editable on the wizard for the exceptional entries.">
                        <field name="bank_fees_account_id"
                               placeholder="Pick an expense account..."
                               options="{'no_create': True}"
                               domain="[('account_type', 'in', ['expense', 'expense_other', 'expense_depreciation', 'expense_direct_cost']), ('company_ids', 'parent_of', company_id)]"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
