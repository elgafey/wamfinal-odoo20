<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The wizard: the selected items, the total, the net amount and the
         fee (both editable, kept consistent both ways), the bank account,
         the date, the reference and the journal. -->
    <record id="bank_fees_allocation_wizard_form" model="ir.ui.view">
        <field name="name">bank.fees.allocation.wizard.form</field>
        <field name="model">bank.fees.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Bank Fees Allocation">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="move_id" invisible="1"/>
                <!-- The accounts the user may pick: the drop-downs filter
                     on them with a plain list of tuples. -->
                <field name="allowed_bank_account_ids" invisible="1"/>
                <field name="allowed_fee_account_ids" invisible="1"/>
                <field name="allowed_journal_ids" invisible="1"/>

                <div class="alert alert-info" role="alert">
                    <p>
                        One single journal entry will be created, posted and reconciled with the
                        selected journal items: the bank receives the net amount, the fee is booked
                        on the fee account and every source account is credited.
                    </p>
                </div>

                <group>
                    <group string="Journal Item">
                        <field name="journal_id"
                               domain="[('id', 'in', allowed_journal_ids)]"/>
                        <field name="date"/>
                        <field name="ref"/>
                    </group>
                    <group string="Amounts">
                        <field name="total_amount" readonly="1"/>
                        <field name="net_amount"/>
                        <field name="fee_amount"/>
                        <field name="bank_account_id"
                               domain="[('id', 'in', allowed_bank_account_ids)]"/>
                        <field name="fee_account_id"
                               domain="[('id', 'in', allowed_fee_account_ids)]"/>
                    </group>
                </group>

                <group string="Selected Journal Items" colspan="2">
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="date"/>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="account_id"/>
                            <field name="name" string="Label"/>
                            <field name="balance" sum="Total Balance"/>
                            <field name="company_currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <button string="Confirm" name="action_post" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bank_fees_allocation_wizard" model="ir.actions.act_window">
        <field name="name">Bank Fees Allocation</field>
        <field name="res_model">bank.fees.allocation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="bank_fees_allocation_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
