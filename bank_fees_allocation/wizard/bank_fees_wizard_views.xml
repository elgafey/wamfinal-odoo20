<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bank Fees Allocation wizard. Shape mirrors
         account_accountant.view_account_reconcile_wizard (the standard
         "Reconcile" button wizard): hidden fields, optional alert, two
         columns (accounts/journal/label | amounts/date/cost center) and a
         footer with one primary action. -->
    <record id="bank_fees_wizard_form" model="ir.ui.view">
        <field name="name">bank.fees.allocation.wizard.form</field>
        <field name="model">bank.fees.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Closing Fees">
                <field name="company_id" invisible="1"/>
                <field name="source_account_id" invisible="1"/>
                <field name="reco_currency_id" invisible="1"/>
                <field name="move_id" invisible="1"/>

                <div class="alert alert-info" role="alert">
                    <p>
                        The selected journal items are left untouched: a single journal entry is
                        created, posted and automatically reconciled with all of them.
                    </p>
                </div>

                <group>
                    <!-- Left side of the form -->
                    <group>
                        <!-- optional (empty = keep the remainder on the source
                             account), green, only Bank and Cash accounts shown -->
                        <field name="unlink_account_id" class="text-success"/>
                        <field name="journal_id" required="1"/>
                        <field name="label"/>
                    </group>
                    <!-- Right side of the form -->
                    <group>
                        <div class="o_td_label">
                            <label for="total_amount" string="Amount" class="o_form_label"/>
                        </div>
                        <div class="d-flex">
                            <div class="d-flex o-row" style="white-space: pre;">
                                <field name="total_amount" readonly="1" class="oe_inline"/>
                            </div>
                        </div>
                        <!-- green = what stays / red = what goes to bank fees.
                             The fees configuration is required only when fees
                             are actually charged: with a zero Bank Fees Amount
                             the fees line is dropped from the entry, so no
                             account and no cost center are needed for it. -->
                        <field name="original_amount" required="1" class="text-success"/>
                        <field name="fees_amount" required="1" class="text-danger"/>
                        <field name="reconciled_total" readonly="1"/>
                        <field name="fees_account_id" required="fees_amount != 0"/>
                        <field name="date" required="1"/>
                        <field name="analytic_distribution" widget="analytic_distribution"
                               string="Cost Center" required="fees_amount != 0"/>
                        <field name="analytic_precision" invisible="1"/>
                    </group>
                </group>

                <!-- Selected journal items (the standard wizard keeps them
                     hidden; we show them because several can be selected). -->
                <group string="Journal Items" colspan="2">
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="move_id"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="amount_residual"/>
                            <field name="company_currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <button string="Post" name="action_post" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
