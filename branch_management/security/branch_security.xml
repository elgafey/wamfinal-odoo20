<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- Privilege (Odoo 20 replaces res.groups.category_id by        -->
        <!-- res.groups.privilege_id)                                     -->
        <!-- ============================================================ -->
        <record id="res_groups_privilege_branch" model="res.groups.privilege">
            <field name="name">Branches</field>
            <field name="category_id" ref="base.module_category_administration"/>
        </record>

        <!-- ============================================================ -->
        <!-- Groups                                                        -->
        <!-- ============================================================ -->

        <!-- Restricted to the branches assigned to the user -->
        <record id="group_branch_user" model="res.groups">
            <field name="name">Branch User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_branch"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Restrict the user to the branches listed in
                the "Branches" tab of the user: the branches, the sales orders,
                the pickings and the invoices of the other branches are then
                hidden.
            </field>
        </record>

        <!-- Creates, modifies and archives the branches -->
        <record id="group_branch_manager" model="res.groups">
            <field name="name">Branch Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_branch"/>
            <field name="implied_ids" eval="[(4, ref('group_branch_user'))]"/>
            <field name="comment">Manage the branches of the companies the user
                has access to (the manager sees every branch, the restriction of
                the "Branch User" group does not apply to them).
            </field>
        </record>

        <!-- Full control, including the assignment of the branches -->
        <record id="group_branch_admin" model="res.groups">
            <field name="name">Branch Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_branch"/>
            <field name="implied_ids" eval="[(4, ref('group_branch_manager'))]"/>
            <field name="comment">Full control over the branches and their
                assignment to the users.
            </field>
        </record>

    </data>
</odoo>
