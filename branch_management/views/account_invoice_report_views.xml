<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================ INVOICES ANALYSIS (account.invoice.report) ================ -->
    <!-- account.invoice.report has no database view in Odoo 20 either: the branch -->
    <!-- column comes from models/account_invoice_report.py (``_select_list``) and  -->
    <!-- the views below only expose it.                                            -->
    <!-- The group by filter also drives the pivot and the graph of the action.     -->

    <record id="account_invoice_report_view_tree_branch" model="ir.ui.view">
        <field name="name">account.invoice.report.list.branch</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.account_invoice_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='invoice_user_id']" position="after">
                <field name="branch_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_report_search_branch" model="ir.ui.view">
        <field name="name">account.invoice.report.search.branch</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='invoice_user_id']" position="after">
                <field name="branch_id"/>
            </xpath>
            <xpath expr="//search/group/filter[@name='user']" position="after">
                <filter string="Branch" name="branch"
                        context="{'group_by': 'branch_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
