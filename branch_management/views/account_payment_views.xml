<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- Payment form: the branch of the payment                       -->
        <!-- ============================================================ -->
        <record id="account_payment_form_branch" model="ir.ui.view">
            <field name="name">account.payment.form.branch</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group1']/field[@name='memo']" position="after">
                    <field name="branch_id" readonly="state != 'draft'"/>
                </xpath>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Payments list: optional "Branch" column                       -->
        <!-- ============================================================ -->
        <record id="account_payment_tree_branch" model="ir.ui.view">
            <field name="name">account.payment.list.branch</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list/field[@name='journal_id']" position="after">
                    <field name="branch_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Payments search: look for a branch and group by it           -->
        <!-- ============================================================ -->
        <record id="account_payment_search_branch" model="ir.ui.view">
            <field name="name">account.payment.search.branch</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="branch_id"/>
                </xpath>
                <xpath expr="//filter[@name='journal']" position="after">
                    <filter string="Branch" name="groupby_branch"
                            domain="[]" context="{'group_by': 'branch_id'}"/>
                </xpath>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Register payment wizard: the branch is proposed to the user  -->
        <!-- ============================================================ -->
        <record id="account_payment_register_form_branch" model="ir.ui.view">
            <field name="name">account.payment.register.form.branch</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group2']/field[@name='communication']" position="after">
                    <field name="branch_id" force_save="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
