<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================== LIST ============================== -->
    <record id="branch_view_list" model="ir.ui.view">
        <field name="name">branch.branch.list</field>
        <field name="model">branch.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="warehouse_id" optional="show"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="manager_id" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================== FORM ============================== -->
    <record id="branch_view_form" model="ir.ui.view">
        <field name="name">branch.branch.form</field>
        <field name="model">branch.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="sale_count == 0">
                            <field name="sale_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_pickings" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_sale_analysis" type="object"
                                class="oe_stat_button" icon="fa-bar-chart"
                                groups="sales_team.group_sale_salesman">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Analysis</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Riyadh Branch"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="BR-RYD"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="manager_id" options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Warehouse">
                            <field name="warehouse_id" options="{'no_create': True}"/>
                            <field name="default_stock_location_id"
                                   invisible="not warehouse_id"
                                   domain="[('usage', '=', 'internal'), ('warehouse_id', '=', warehouse_id)]"
                                   options="{'no_create': True}"/>
                            <field name="default_customer_location_id" options="{'no_create': True}"/>
                            <field name="default_vendor_location_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Sales">
                        <field name="pricelist_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Analytic Accounting">
                        <field name="auto_create_analytic" widget="boolean_toggle"/>
                        <field name="analytic_plan_id"
                               invisible="not auto_create_analytic"/>
                        <field name="analytic_account_id"/>
                    </group>
                    <group>
                        <group string="Address and Contact">
                            <field name="address_id" options="{'no_create': True}"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal notes about the branch..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================= SEARCH ============================= -->
    <record id="branch_view_search" model="ir.ui.view">
        <field name="name">branch.branch.search</field>
        <field name="model">branch.branch</field>
        <field name="arch" type="xml">
            <search string="Branches">
                <field name="name"/>
                <field name="code"/>
                <field name="warehouse_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="company" context="{'group_by': 'company_id'}"/>
                    <filter string="Warehouse" name="warehouse" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================= ACTION ============================= -->
    <record id="branch_action" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">branch.branch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="branch_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first branch
            </p>
            <p>
                A branch is the link between your sales, your inventory,
                your accounting and your analytic accounting.
            </p>
        </field>
    </record>

    <!-- ============================== MENUS ============================= -->
    <!-- Sales &gt; Configuration -->
    <menuitem id="menu_branch_sales"
              name="Branches"
              parent="sale.menu_sale_config"
              action="branch_action"
              sequence="45"/>

    <!-- Inventory &gt; Configuration -->
    <menuitem id="menu_branch_stock"
              name="Branches"
              parent="stock.menu_stock_config_settings"
              action="branch_action"
              sequence="45"/>

    <!-- Accounting &gt; Configuration -->
    <menuitem id="menu_branch_account"
              name="Branches"
              parent="account.menu_finance_configuration"
              action="branch_action"
              sequence="45"/>

    <!-- Settings &gt; Branches -->
    <menuitem id="menu_branch_settings"
              name="Branches"
              parent="base.menu_administration"
              action="branch_action"
              sequence="6"
              groups="base.group_system,base.group_erp_manager"/>

</odoo>
