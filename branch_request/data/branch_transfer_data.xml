<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence used by branch.transfer: BT/00001, BT/00002, ... -->
        <record id="seq_branch_transfer" model="ir.sequence">
            <field name="name">Branch Transfer</field>
            <field name="code">branch.transfer</field>
            <field name="prefix">BT/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- The single global transit location shared by every transfer,
             created the same way as the stock module transit locations:
             no parent and no company, so it is usable by all of them. -->
        <record id="branch_transfer_location_transit" model="stock.location">
            <field name="name">Branch Transit</field>
            <field name="usage">transit</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>

    <!-- Runs on every install/upgrade: transfers created before the
         checkbox list existed get their list of supplying branches back. -->
    <data noupdate="0">
        <function model="branch.transfer" name="_backfill_supplier_lines"/>
    </data>
</odoo>
