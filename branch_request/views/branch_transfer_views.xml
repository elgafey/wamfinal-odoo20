<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Search ==================== -->
    <record id="view_branch_transfer_search" model="ir.ui.view">
        <field name="name">branch.transfer.search</field>
        <field name="model">branch.transfer</field>
        <field name="arch" type="xml">
            <search string="Branch Transfers">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="to_location_name"/>
                <field name="from_location_name"/>
                <separator/>
                <filter name="mine" string="My Requests"
                        domain="['|', ('to_user_ids', 'in', [uid]), ('requester_id', '=', uid)]"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="in_transit" string="In Transit"
                        domain="[('state', '=', 'in_transit')]"/>
                <filter name="received" string="Received"
                        domain="[('state', '=', 'received')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter name="cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="difference" string="With difference"
                        domain="[('has_difference', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_from_location" string="Supplying Branch"
                            context="{'group_by': 'from_location_name'}"/>
                    <filter name="group_by_to_location" string="Requesting Branch"
                            context="{'group_by': 'to_location_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== List ==================== -->
    <record id="view_branch_transfer_list" model="ir.ui.view">
        <field name="name">branch.transfer.list</field>
        <field name="model">branch.transfer</field>
        <field name="arch" type="xml">
            <list string="Branch Transfers" decoration-danger="has_difference">
                <field name="name"/>
                <field name="to_location_name" string="Requesting Branch"/>
                <field name="from_location_name" string="Supplying Branch"/>
                <field name="request_date"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'received'"
                       decoration-info="state in ('draft', 'submitted')"
                       decoration-warning="state == 'in_transit'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="has_difference" string="Difference"/>
            </list>
        </field>
    </record>

    <!-- ==================== Form ==================== -->
    <record id="view_branch_transfer_form" model="ir.ui.view">
        <field name="name">branch.transfer.form</field>
        <field name="model">branch.transfer</field>
        <field name="arch" type="xml">
            <form string="Branch Transfer">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft' or not is_requester"/>
                    <button name="action_open_reject_wizard" type="object"
                            string="Reject"
                            invisible="state != 'submitted' or not is_supplying"/>
                    <button name="action_open_send_wizard" type="object"
                            string="Approve &amp; Send" class="btn-primary"
                            invisible="state != 'submitted' or not is_supplying"/>
                    <button name="action_open_receive_wizard" type="object"
                            string="Receive" class="btn-primary"
                            invisible="state != 'in_transit' or not is_requesting"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted') or not (is_requester or is_procurement)"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled') or not is_requester"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,in_transit,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"
                         groups="branch_request.group_branch_request_procurement">
                        <button name="action_view_out_picking" type="object"
                                class="oe_stat_button" icon="truck"
                                invisible="not out_picking_id">
                            <field name="out_picking_count" widget="statinfo"
                                   string="Sent"/>
                        </button>
                        <button name="action_view_in_picking" type="object"
                                class="oe_stat_button" icon="truck"
                                invisible="not in_picking_id">
                            <field name="in_picking_count" widget="statinfo"
                                   string="Received"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="requester_id"/>
                            <field name="request_date"/>
                            <field name="to_location_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   invisible="state != 'draft'"/>
                            <field name="to_location_name" readonly="1"
                                   invisible="state == 'draft'"/>
                        </group>
                        <group string="Follow-up">
                            <field name="sent_by_id" invisible="not sent_by_id"/>
                            <field name="sent_date" invisible="not sent_date"/>
                            <field name="received_by_id" invisible="not received_by_id"/>
                            <field name="received_date" invisible="not received_date"/>
                        </group>
                    </group>
                    <group string="Supplying branch (tick one)" col="1"
                           invisible="state != 'draft'">
                        <div style="max-height: 300px; overflow: auto;">
                            <field name="supplier_line_ids" nolabel="1">
                                <list string="Supplying branches"
                                      editable="bottom" create="false"
                                      delete="false">
                                    <field name="selected"
                                           widget="boolean_toggle"
                                           string="Select"/>
                                    <!-- The location_id many2one must
                                         never be requested here: the
                                         employee may not read the supplying
                                         branch location.  The technical
                                         integer echo is resolved back into
                                         location_id by create() with
                                         sudo. -->
                                    <field name="location_ref" invisible="1"
                                           force_save="1"/>
                                    <field name="location_name" readonly="1"/>
                                </list>
                            </field>
                        </div>
                    </group>
                    <group string="Supplying branch"
                           invisible="state == 'draft'">
                        <field name="from_location_name" readonly="1"
                               groups="!branch_request.group_branch_request_procurement"/>
                        <field name="from_location_id" readonly="1"
                               groups="branch_request.group_branch_request_procurement"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group string="Stock Operations"
                           groups="branch_request.group_branch_request_procurement">
                        <field name="out_picking_id" invisible="not out_picking_id"
                               options="{'no_create': True}"/>
                        <field name="in_picking_id" invisible="not in_picking_id"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Rejection" invisible="state != 'rejected'">
                        <field name="rejection_reason" readonly="1"/>
                    </group>
                    <group string="Note">
                        <field name="note"
                               placeholder="Anything the other branch should know?"/>
                    </group>
                    <field name="is_procurement" invisible="1"/>
                    <field name="is_requester" invisible="1"/>
                    <field name="is_supplying" invisible="1"/>
                    <field name="is_requesting" invisible="1"/>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list string="Products" editable="bottom"
                              decoration-danger="difference_qty != 0">
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="requested_qty"/>
                            <field name="available_qty" readonly="1"
                                   column_invisible="not parent.is_supplying"/>
                            <field name="sent_qty" readonly="1"/>
                            <field name="received_qty" readonly="1"/>
                            <field name="difference_qty" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== Actions ==================== -->
    <record id="action_branch_transfer_my" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">branch.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_branch_transfer_search"/>
        <field name="domain">['|', ('to_user_ids', 'in', [uid]), ('requester_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Request goods from another branch</p>
            <p>Select the products your branch needs and send the request to
               the branch that holds them.</p>
        </field>
    </record>

    <record id="action_branch_transfer_incoming" model="ir.actions.act_window">
        <field name="name">Incoming Requests</field>
        <field name="res_model">branch.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_branch_transfer_search"/>
        <field name="domain">[('from_user_ids', 'in', [uid])]</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No incoming request</p>
            <p>Goods requested from your branch show up here for approval.</p>
        </field>
    </record>

    <record id="action_branch_transfer_to_receive" model="ir.actions.act_window">
        <field name="name">To Receive</field>
        <field name="res_model">branch.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_branch_transfer_search"/>
        <field name="domain">[('to_user_ids', 'in', [uid]), ('state', '=', 'in_transit')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to receive</p>
            <p>Goods waiting in the branch transit location appear here.</p>
        </field>
    </record>

    <record id="action_branch_transfer_all" model="ir.actions.act_window">
        <field name="name">All Transfers</field>
        <field name="res_model">branch.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_branch_transfer_search"/>
        <field name="group_ids" eval="[(6, 0, [ref('branch_request.group_branch_request_procurement')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No branch transfer yet</p>
            <p>Every transfer between two branches is listed here.</p>
        </field>
    </record>

    <!-- ==================== Menus ==================== -->
    <menuitem id="menu_branch_transfer_root" name="Branch Transfers"
              parent="menu_branch_request_root" sequence="30"/>

    <menuitem id="menu_branch_transfer_my" name="My Requests"
              parent="menu_branch_transfer_root"
              action="action_branch_transfer_my" sequence="10"/>

    <menuitem id="menu_branch_transfer_incoming" name="Incoming Requests"
              parent="menu_branch_transfer_root"
              action="action_branch_transfer_incoming" sequence="20"/>

    <menuitem id="menu_branch_transfer_to_receive" name="To Receive"
              parent="menu_branch_transfer_root"
              action="action_branch_transfer_to_receive" sequence="30"/>

    <menuitem id="menu_branch_transfer_all" name="All Transfers"
              parent="menu_branch_transfer_root"
              action="action_branch_transfer_all" sequence="40"
              groups="branch_request.group_branch_request_procurement"/>

    <menuitem id="menu_branch_transfer_keepers" name="Store Keepers"
              parent="menu_branch_transfer_root"
              action="action_branch_store_keeper" sequence="50"
              groups="branch_request.group_branch_request_procurement,base.group_system"/>

</odoo>
