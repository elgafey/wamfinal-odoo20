<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Small QWeb PDF of a request.  Deliberately without any price:
         pricing is handled by the procurement team outside this module. -->
    <template id="report_branch_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="doc.name"/>
                            <small> — Branch Request</small>
                        </h2>
                        <table class="table table-sm">
                            <tr>
                                <th>Requester</th>
                                <td><span t-field="doc.requester_id"/></td>
                            </tr>
                            <tr>
                                <th>Request Date</th>
                                <td><span t-field="doc.request_date"/></td>
                            </tr>
                            <tr>
                                <th>Priority</th>
                                <td><span t-field="doc.priority"/></td>
                                <th>Status</th>
                                <td><span t-field="doc.state"/></td>
                            </tr>
                        </table>
                        <div t-if="doc.rejection_reason">
                            <h3>Rejection Reason</h3>
                            <p t-field="doc.rejection_reason"/>
                        </div>
                        <h3>Products</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th>UoM</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><span t-field="line.product_id"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td><span t-field="line.uom_id"/></td>
                                </tr>
                                <tr t-if="not doc.line_ids">
                                    <td colspan="4">No products.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
