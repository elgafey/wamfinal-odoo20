<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         Paper format: A4 landscape so the eight columns get some air.

         header_line / header_spacing are deliberately off: the wkhtmltopdf
         binary shipped here has an unpatched Qt and ignores (or breaks on)
         header &amp; footer switches, so the report title band and the closing
         band are rendered inside the page body instead of using the
         external header / footer html mechanism.
         =================================================================== -->
    <record id="paperformat_stock_move_detail_report" model="report.paperformat">
        <field name="name">Stock Move Detail Report (A4 Landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">14</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing" eval="0"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_stock_move_detail" model="ir.actions.report">
        <field name="name">Stock Move Detail</field>
        <field name="model">stock.move.detail.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_move_detail_report.document</field>
        <field name="print_report_name">'Stock Move Detail %s - %s' % (object.date_from, object.date_to)</field>
        <field name="binding_model_id" ref="model_stock_move_detail_report"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_stock_move_detail_report"/>
    </record>

    <!-- ===================================================================
         The document. Everything (title band, key figures, table, note and
         closing band) lives inside the single .article node, because only
         that node is kept in the page body by ir.actions.report.
         =================================================================== -->
    <template id="document">
        <t t-set="title">Stock Move Detail Report</t>
        <t t-call="web.report_layout">
            <t t-foreach="docs" t-as="doc">

                <div class="article sdr-doc"
                     t-att-data-oe-model="doc._name"
                     t-att-data-oe-id="doc.id"
                     t-att-data-oe-lang="doc.env.context.get('lang')">
                    <style>
                        .sdr-doc {
                            font-family: Arial, "Liberation Sans", "Noto Sans Arabic",
                                         "DejaVu Sans", sans-serif;
                            font-size: 8.5pt; color: #2b3440;
                        }

                        /* web.report_layout forces `html, body { direction: ltr }`,
                           so the rtl direction has to be set again on the document
                           itself; every table below then mirrors correctly. */
                        [dir="rtl"] .sdr-doc { direction: rtl; }

                        /* ================= title band ================= */
                        .sdr-band {
                            width: 100%; border-collapse: collapse;
                            table-layout: fixed; margin-bottom: 1.5mm;
                        }
                        .sdr-band td { vertical-align: bottom; padding: 0; }
                        .sdr-band-logo { width: 66mm; }
                        .sdr-band-logo img { max-height: 15mm; max-width: 62mm; }
                        .sdr-band-title {
                            color: #1f3a5f; font-size: 18pt; font-weight: bold;
                            line-height: 1.05; letter-spacing: -0.3pt;
                        }
                        .sdr-band-sub {
                            font-size: 8.5pt; color: #5b6675; margin-top: 1.8mm;
                        }
                        .sdr-band-sub .sdr-period, .sdr-band-sub .sdr-chip {
                            display: inline-block; background: #eaf0f7;
                            color: #1f3a5f; border: 0.4pt solid #c9d5e3;
                            border-radius: 2pt; padding: 0.7mm 2.2mm;
                            font-weight: bold; margin: 0 2mm;
                        }
                        .sdr-band-sub .sdr-chip {
                            background: #f5f8fb; color: #5b6675;
                            font-weight: normal;
                        }
                        /* date ranges and timestamps must keep their ltr order
                           even when the surrounding document is rtl */
                        .sdr-period, .sdr-meta-value {
                            direction: ltr; unicode-bidi: embed;
                        }
                        .sdr-band-meta {
                            width: 74mm; text-align: right;
                            font-size: 7.5pt; color: #7a8493;
                        }
                        .sdr-band-meta .sdr-meta-value {
                            font-size: 8.5pt; color: #1f3a5f;
                            font-weight: bold; margin-top: 0.8mm;
                        }
                        [dir="rtl"] .sdr-band-meta { text-align: left; }
                        .sdr-rule {
                            border: none; border-top: 2.4pt solid #1f3a5f;
                            margin: 0 0 4.5mm 0;
                        }

                        /* ================= key figures ================= */
                        .sdr-kpis {
                            width: 100%; border-collapse: separate;
                            border-spacing: 2.5mm 0; table-layout: fixed;
                            margin: 0 0 4.5mm 0;
                        }
                        .sdr-kpi {
                            width: 16.6%; background: #fbfcfe;
                            border: 0.4pt solid #d7dee7;
                            border-top: 3pt solid #8a97a8;
                            padding: 2mm 2.4mm 2.4mm 2.4mm;
                        }
                        .sdr-kpi-label {
                            font-size: 7pt; color: #77828f;
                            text-transform: uppercase; letter-spacing: 0.5pt;
                            white-space: nowrap;
                        }
                        .sdr-kpi-value {
                            font-size: 14pt; font-weight: bold; color: #1f3a5f;
                            margin-top: 1.2mm; white-space: nowrap;
                        }
                        .sdr-kpi-products { border-top-color: #1f3a5f; }
                        .sdr-kpi-moves { border-top-color: #8a97a8; }
                        .sdr-kpi-opening { border-top-color: #9a7b25; }
                        .sdr-kpi-opening .sdr-kpi-value { color: #9a7b25; }
                        .sdr-kpi-in { border-top-color: #1f7a4d; }
                        .sdr-kpi-in .sdr-kpi-value { color: #1f7a4d; }
                        .sdr-kpi-out { border-top-color: #b3382c; }
                        .sdr-kpi-out .sdr-kpi-value { color: #b3382c; }
                        .sdr-kpi-closing { border-top-color: #0b6e78; }
                        .sdr-kpi-closing .sdr-kpi-value { color: #0b6e78; }

                        /* ================= table ================= */
                        .sdr-table {
                            width: 100%; border-collapse: collapse;
                            table-layout: fixed; font-size: 8.5pt;
                        }
                        .sdr-table thead th {
                            background-color: #1f3a5f; color: #ffffff;
                            font-size: 7.5pt; font-weight: bold;
                            text-transform: uppercase; letter-spacing: 0.4pt;
                            padding: 2mm 2.4mm; border: 0.4pt solid #1f3a5f;
                            text-align: left;
                        }
                        .sdr-table tbody td {
                            padding: 1.5mm 2.4mm; border: 0.4pt solid #dfe4ea;
                            vertical-align: top;
                        }
                        .sdr-table tbody tr:nth-child(even) td {
                            background-color: #f5f8fb;
                        }
                        .sdr-date { white-space: nowrap; }
                        .sdr-ref { color: #5b6675; }
                        .sdr-uom { color: #5b6675; white-space: nowrap; }
                        .sdr-num { text-align: right; white-space: nowrap; }
                        .sdr-bal { font-weight: bold; color: #0b6e78; }
                        /* first line of a product: the opening balance */
                        .sdr-table tbody tr.sdr-open td {
                            background-color: #fbf4e4 !important;
                            font-weight: bold; color: #7a5c10;
                            border-top: 1.2pt solid #9aa7b8;
                        }
                        .sdr-table tbody tr.sdr-open td.sdr-bal { color: #9a7b25; }
                        .sdr-table tbody tr.sdr-total td {
                            background-color: #e6ecf4 !important;
                            border-top: 1.6pt solid #1f3a5f; font-weight: bold;
                            font-size: 9pt; color: #1f3a5f;
                            padding-top: 2mm; padding-bottom: 2mm;
                        }
                        .sdr-table tbody tr { page-break-inside: avoid; }

                        /* alignment rules last so they win in both directions */
                        .sdr-table thead th.sdr-num { text-align: right; }
                        [dir="rtl"] .sdr-table thead th { text-align: right; }

                        /* ================= note + closing band ================= */
                        /* plain stacked block: floats and fixed table columns are
                           positioned incorrectly by this wkhtmltopdf build in rtl */
                        .sdr-note {
                            margin-top: 4mm; font-size: 7.5pt; color: #77828f;
                            background: #f7f9fc; border: 0.4pt solid #e2e8f0;
                            border-left: 2.5pt solid #1f3a5f;
                            padding: 2.4mm 3mm 2.6mm 3mm; line-height: 1.45;
                            border-radius: 1pt;
                        }
                        /* Alignment of the note, measured on this wkhtmltopdf
                           build (0.12.6): what keeps a rtl line inside the
                           tinted band is the *bidi class* of its punctuation,
                           not the direction of this rule. A class CS character
                           (the arabic comma U+060C, or a latin , . :) anchors
                           the line to the right edge of the page instead of the
                           right edge of its own box, so it is painted at 1695px
                           and escapes the 1676px content edge -- and it does so
                           with this rule set to ltr and with it set to rtl.
                           Class AL (semicolon U+061B, full stop U+06D4) has no
                           such problem: then ltr and rtl paint identical pixels
                           and every note line ends at 1656px, 20px clear of the
                           edge. The rule is kept anyway because it carries the
                           accent border to the right, which is what an rtl
                           document needs, and because it matches the sibling
                           report. The shipped translation only uses AL. */
                        [dir="rtl"] .sdr-note {
                            direction: ltr;
                            text-align: right;
                            border-left: 0.4pt solid #e2e8f0;
                            border-right: 2.5pt solid #1f3a5f;
                        }
                        .sdr-note-label {
                            color: #1f3a5f; font-weight: bold;
                            margin: 0 0 0.8mm 0;
                        }
                        .sdr-note-text { margin: 0; white-space: normal; }
                        .sdr-empty {
                            border: 0.6pt dashed #b6c0cd; background: #f7f9fc;
                            color: #5b6675; text-align: center;
                            padding: 9mm 4mm; font-size: 10pt; border-radius: 2pt;
                        }
                        .sdr-closing {
                            width: 100%; border-collapse: collapse;
                            table-layout: auto; margin-top: 4.5mm;
                        }
                        .sdr-closing td {
                            border-top: 0.6pt solid #ccd6e2; padding-top: 1.8mm;
                            font-size: 7.5pt; color: #7a8493;
                        }
                        .sdr-closing td + td {
                            border-left: 0.6pt solid #e4e9ef;
                            padding-left: 3mm; padding-right: 0;
                        }
                        [dir="rtl"] .sdr-closing td + td {
                            border-left: 0; padding-left: 0;
                            padding-right: 3mm; border-right: 0.6pt solid #e4e9ef;
                        }
                        .sdr-closing td.sdr-closing-company { color: #1f3a5f; font-weight: bold; white-space: nowrap; }
                        .sdr-closing td.sdr-closing-title {
                            color: #1f3a5f; text-transform: uppercase;
                            letter-spacing: 0.4pt; white-space: nowrap;
                        }
                        .sdr-closing td.sdr-closing-label { color: #93a0ae; white-space: nowrap; }
                        .sdr-closing td.sdr-closing-value { color: #5b6675; white-space: nowrap; }
                        .sdr-closing-spacer { width: 100%; }
                    </style>

                    <!-- ============ title band ============ -->
                    <table class="sdr-band">
                        <tr>
                            <td class="sdr-band-logo" t-if="doc.company_id.logo">
                                <img t-att-src="image_data_uri(doc.company_id.logo)" alt=""/>
                            </td>
                            <td>
                                <div class="sdr-band-title">Stock Move Detail Report</div>
                                <div class="sdr-band-sub">
                                    <span class="sdr-period"><span t-out="doc.date_from"/> → <span t-out="doc.date_to"/></span>
                                    <span class="sdr-chip" t-out="doc.location_id.complete_name"/>
                                    <span class="sdr-chip" t-if="doc.product_id" t-out="doc.product_id.display_name"/>
                                    <span t-out="doc.company_id.name"/>
                                </div>
                            </td>
                            <td class="sdr-band-meta">
                                <div>Generated on</div>
                                <div class="sdr-meta-value"><span t-out="printed_at"/> · <span t-out="printed_by"/></div>
                            </td>
                        </tr>
                    </table>
                    <hr class="sdr-rule"/>

                    <t t-set="sdr_lines" t-value="doc.line_ids"/>

                    <t t-if="sdr_lines">

                        <!-- ============ key figures ============ -->
                        <table class="sdr-kpis">
                            <tr>
                                <td class="sdr-kpi sdr-kpi-products">
                                    <div class="sdr-kpi-label">Products</div>
                                    <div class="sdr-kpi-value" t-out="doc.product_count"/>
                                </td>
                                <td class="sdr-kpi sdr-kpi-moves">
                                    <div class="sdr-kpi-label">Moves</div>
                                    <div class="sdr-kpi-value" t-out="doc.move_count"/>
                                </td>
                                <td class="sdr-kpi sdr-kpi-opening">
                                    <div class="sdr-kpi-label">Opening Balance</div>
                                    <div class="sdr-kpi-value" t-out="'%.2f' % doc.total_opening"/>
                                </td>
                                <td class="sdr-kpi sdr-kpi-in">
                                    <div class="sdr-kpi-label">IN</div>
                                    <div class="sdr-kpi-value" t-out="'%.2f' % doc.total_in"/>
                                </td>
                                <td class="sdr-kpi sdr-kpi-out">
                                    <div class="sdr-kpi-label">OUT</div>
                                    <div class="sdr-kpi-value" t-out="'%.2f' % doc.total_out"/>
                                </td>
                                <td class="sdr-kpi sdr-kpi-closing">
                                    <div class="sdr-kpi-label">Closing Balance</div>
                                    <div class="sdr-kpi-value" t-out="'%.2f' % doc.total_closing"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ============ table ============ -->
                        <table class="sdr-table">
                            <colgroup>
                                <col style="width: 22mm"/>
                                <col style="width: 34mm"/>
                                <col style="width: 48mm"/>
                                <col style="width: 16mm"/>
                                <col style="width: 22mm"/>
                                <col style="width: 22mm"/>
                                <col/>
                                <col style="width: 28mm"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th rowspan="2">Date</th>
                                    <th rowspan="2">Move</th>
                                    <th rowspan="2">Product</th>
                                    <th rowspan="2">Unit</th>
                                    <th class="sdr-num" colspan="2">Quantity</th>
                                    <th rowspan="2">Counterpart Location</th>
                                    <th class="sdr-num" rowspan="2">Balance</th>
                                </tr>
                                <tr>
                                    <th class="sdr-num">IN</th>
                                    <th class="sdr-num">OUT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="sdr_lines" t-as="line"
                                    t-att-class="line.is_opening and 'sdr-open' or ''">
                                    <td class="sdr-date" t-out="line.date"/>
                                    <td class="sdr-ref" t-out="line.name"/>
                                    <td t-out="line.product_id.name"/>
                                    <td class="sdr-uom" t-out="line.uom_id.name"/>
                                    <td class="sdr-num" t-out="'' if line.is_opening else '%.2f' % line.qty_in"/>
                                    <td class="sdr-num" t-out="'' if line.is_opening else '%.2f' % line.qty_out"/>
                                    <td class="sdr-ref" t-out="line.counterpart or ''"/>
                                    <td class="sdr-num sdr-bal" t-out="'%.2f' % line.balance"/>
                                </tr>
                                <tr class="sdr-total">
                                    <td/>
                                    <td>Total</td>
                                    <td/>
                                    <td/>
                                    <td class="sdr-num" t-out="'%.2f' % doc.total_in"/>
                                    <td class="sdr-num" t-out="'%.2f' % doc.total_out"/>
                                    <td/>
                                    <td class="sdr-num" t-out="'%.2f' % doc.total_closing"/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Two short paragraphs, one on the quantities and
                             units, one on the opening balance and the running
                             balance. The Arabic translation of both in
                             i18n/ar_001.po must only use punctuation of bidi
                             class AL (U+061B ; and U+06D4 .): an arabic comma
                             U+060C is class CS and makes this wkhtmltopdf push
                             the whole line out of the band, see the comment on
                             the .sdr-note rule above. -->
                        <div class="sdr-note">
                            <div class="sdr-note-label">Note:</div>
                            <div class="sdr-note-text">Quantities are expressed in the unit of measure of the product. The report covers the selected location and its sub-locations: a move is IN when it enters the location from outside and OUT when it leaves it; transfers staying inside the location are not shown.</div>
                            <div class="sdr-note-text">The first line of every product is its opening balance (stock of the location before the From date), and the balance column is the stock of the location after each move.</div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="sdr-empty">
                            No stock movement was found for the selected location and period.
                        </div>
                    </t>

                    <!-- ============ closing band ============ -->
                    <table class="sdr-closing">
                        <tr>
                            <td class="sdr-closing-company"><t t-out="doc.company_id.name"/></td>
                            <td class="sdr-closing-title">Stock Move Detail Report</td>
                            <td class="sdr-closing-spacer"></td>
                            <td class="sdr-closing-label">Generated on</td>
                            <td class="sdr-closing-value"><t t-out="printed_at"/></td>
                            <td class="sdr-closing-value"><t t-out="printed_by"/></td>
                        </tr>
                    </table>

                </div>

            </t>
        </t>
    </template>

</odoo>
